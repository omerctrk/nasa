ASTRA_APP_NAME=ASTRA HEALTH API
ASTRA_APP_VERSION=0.1.0
ASTRA_API_PREFIX=/api
ASTRA_DEBUG=false
ASTRA_CORS_ORIGINS=["http://localhost:3000"]

ASTRA_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
ASTRA_QDRANT_URL=http://localhost:6333
ASTRA_QDRANT_COLLECTION_NAME=astra_health_knowledge_cards
ASTRA_RETRIEVAL_TOP_K=5
ASTRA_RETRIEVAL_MIN_SIMILARITY_SCORE=0.0

# Database credentials: set locally, never commit real credentials.
COLLAB_DB_PASSWORD=<set-locally>
ASTRA_DATABASE_HOST=your-sql-server-host
ASTRA_DATABASE_PORT=1433
ASTRA_DATABASE_NAME=your-database-name
ASTRA_DATABASE_USERNAME=your-database-username
ASTRA_DATABASE_DRIVER=ODBC Driver 18 for SQL Server
ASTRA_DATABASE_ENVIRONMENT=development
ASTRA_DATABASE_TRUST_SERVER_CERTIFICATE=false

# Repository: memory or sqlserver
ASTRA_KNOWLEDGE_CARD_REPOSITORY=memory
