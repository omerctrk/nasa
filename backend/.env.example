# Şablon (şema §8). Gerçek değerler proje kökündeki .env dosyasına yazılır:
#   cp backend/.env.example .env        (astra-health/ içinden)
# .env git'e GİRMEZ. Her servis yalnız kendi değerini alır (docker-compose.yml).
#
# SQL Server şifre kuralı: en az 8 karakter; büyük harf, küçük harf, rakam, sembolden en az üçü.

# --- MS SQL (teknik hesaplar; core.Users'taki astronot/kule hesaplarından ayrıdır) ---
MSSQL_SA_PASSWORD=
ASTRA_APP_DB_PASSWORD=
ASTRA_EVAL_DB_PASSWORD=

# --- SANS göz modeli API'si (SQL bağlantısı YOK; değerler SANS ekibinden gelecek) ---
SANS_API_BASE_URL=
SANS_API_ANALYZE_PATH=/v1/sans/analyze
SANS_API_TOKEN=

# --- Giriş token'ı (sözleşme §5; HS256). Güçlü rastgele değer üretin:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
